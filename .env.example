# Public Supabase values. Copy this file to .env.local and fill them in.
# Use the project URL and the anon (public) key. Do not put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional canonical site URL for SEO / Open Graph (no trailing slash).
# Leave unset to keep the current default / Vercel URL. Change only when the real domain is ready.
# NEXT_PUBLIC_SITE_URL=

# Optional: email alert when someone submits Ask Question.
# Create a free Resend API key at https://resend.com
RESEND_API_KEY=
NOTIFY_EMAIL=
# Optional verified sender, e.g. "Naveed Alam <hello@yourdomain.com>"
NOTIFY_FROM_EMAIL=
